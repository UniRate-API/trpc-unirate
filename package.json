{
  "name": "trpc-unirate",
  "version": "0.1.0",
  "description": "Pre-built tRPC router for the UniRate currency-exchange API. Drop-in createUniRateRouter() with Zod-validated procedures for convert, rates, historical, time-series, currencies, and VAT.",
  "type": "module",
  "license": "MIT",
  "author": "UniRate (https://unirateapi.com)",
  "homepage": "https://github.com/UniRate-API/trpc-unirate#readme",
  "bugs": "https://github.com/UniRate-API/trpc-unirate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniRate-API/trpc-unirate.git"
  },
  "keywords": [
    "trpc",
    "trpc-router",
    "unirate",
    "currency",
    "exchange-rates",
    "forex",
    "money",
    "fx",
    "zod",
    "fintech"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0",
    "zod": "^3.22.0 || ^4.0.0"
  },
  "devDependencies": {
    "@trpc/server": "^11.0.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
